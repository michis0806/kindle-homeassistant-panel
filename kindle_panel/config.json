{
  "name": "Kindle Panel",
  "version": "0.10.0",
  "slug": "kindle_panel",
  "description": "Home-Assistant-Dashboards für mehrere Kindle-Panels mit Live-Werten",
  "arch": [
    "amd64",
    "aarch64"
  ],
  "startup": "application",
  "boot": "auto",
  "init": false,
  "homeassistant_api": true,
  "ingress": true,
  "ingress_port": 8099,
  "ingress_entry": "/admin/",
  "panel_icon": "mdi:tablet",
  "panel_title": "Kindle Panel",
  "panel_admin": true,
  "ports": {
    "8080/tcp": 8098
  },
  "ports_description": {
    "8080/tcp": "Kindle-Seite im lokalen Netz"
  },
  "watchdog": "http://[HOST]:[PORT:8080]/health",
  "options": {
    "refresh_seconds": 30
  },
  "schema": {
    "refresh_seconds": "int(10,300)"
  },
  "url": "https://github.com/michis0806/kindle-homeassistant-panel"
}
